# Keep the build context small and the image clean: anything generated
# locally would either be rebuilt in the image or has no business in it.
.git
.gitignore
**/node_modules
**/dist
**/__pycache__
**/*.py[cod]
**/.venv
**/.pytest_cache
*.db
*.db-journal
**/.env
.DS_Store
README.md
DESIGN.md
frontend/DESIGN.md
backend/tests
backend/requirements-dev.txt
